<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
</head>
<body>
    <table border="black">
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>UserName</th>
            <th>Action</th>
        </tr>
        <% for (let user of users) { %>
            <tr>
                <td> <%= user.id %> </td>
                <td> <%= user.email %> </td>
                <td> <%= user.username %> </td>
                <td><form method="GET" action="/users/<%= user.id %>/edit"><button>Edit UserName</button></form></td>
            </tr>
        <% } %>
    </table>
</body>
</html>
