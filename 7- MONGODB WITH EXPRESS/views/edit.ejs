<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit form</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>Edit Your Chat: <i><b><%= chat.from %></b></i></h3>
    <p>This Chat was send from: <i><b><%= chat.from %></b></i> to: <i><b><%= chat.to %></b></i></p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="5" cols="10"><%= chat.msg %></textarea>
        <button>edit</button>
    </form>
</body>
</html>